<Window x:Class="PZ2_VAR5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PZ2_VAR5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF76E383">
            <TextBlock Text="ПРАКТИЕСКАЯ РАБОТА №2 Вариант №8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <Button x:Name="btnBack" Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Center" Width="80" Height="30" Margin="0,0,15,0" Visibility="Collapsed" Click="btnBack_Click"/>
        </Grid>

        <Grid Grid.Row="1" Background="#F5F5F5">
            <StackPanel x:Name="spMenu" VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                <TextBlock Text="Выберите задание:" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <Button Content="Задача 1 " Height="35" Margin="0,5" Click="btnTask1_Click"/>
                <Button Content="Задача 2 " Height="35" Margin="0,5" Click="btnTask2_Click"/>
                <Button Content="Задача 3 " Height="35" Margin="0,5" Click="btnTask3_Click"/>
                <Button Content="Задача 4 " Height="35" Margin="0,5" Click="btnTask4_Click"/>
                <Button Content="Задача 5 " Height="35" Margin="0,5" Click="btnTask5_Click"/>
            </StackPanel>
            <Frame x:Name="FrmMain" NavigationUIVisibility="Hidden" ContentRendered="FrmMain_ContentRendered"/>
        </Grid>
    </Grid>
</Window>
