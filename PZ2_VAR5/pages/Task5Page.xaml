<Page x:Class="PZ2_VAR5.pages.Task5Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Task5Page" Height="450" Width="800">
    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30" MaxWidth="700" HorizontalAlignment="Left">
                <TextBlock Text="Задача 5: Двумерный массив N x M (от -10 до 10)" 
                           FontSize="20" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Строк (N):" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="tbRows" Width="50" Height="35" FontSize="16" Text="3" 
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Столбцов (M):" FontSize="15" VerticalAlignment="Center" Margin="20,0,8,0"/>
                    <TextBox x:Name="tbCols" Width="50" Height="35" FontSize="16" Text="4" 
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                    <Button Content="Сгенерировать" Width="150" Height="35" FontSize="14" FontWeight="SemiBold"
                            Margin="25,0,0,0" Click="btnCalculate_Click"/>
                </StackPanel>

                <TextBlock x:Name="tbResult" FontSize="16" FontFamily="Consolas" Foreground="#1E88E5"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>