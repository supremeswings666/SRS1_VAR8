<Page x:Class="PZ2_VAR5.pages.Task1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Task1Page" Height="450" Width="800">
    <Grid Background="White">
        <StackPanel Margin="40,30" MaxWidth="650" HorizontalAlignment="Left">
            <TextBlock Text="Задача 1: Словесное описание числа (от -999 до 999)" 
                       FontSize="20" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,25"/>

            <TextBlock Text="Введите число:" FontSize="15" Margin="0,0,0,8"/>

            <TextBox x:Name="tbInput" Width="300" Height="38" FontSize="16" 
                     Padding="8,5" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>

            <Button Content="Рассчитать" Width="160" Height="38" FontSize="15" FontWeight="SemiBold"
                    HorizontalAlignment="Left" Margin="0,20,0,25" Click="btnCalculate_Click"/>

            <TextBlock x:Name="tbResult" FontSize="17" FontWeight="Medium" Foreground="#1E88E5" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>