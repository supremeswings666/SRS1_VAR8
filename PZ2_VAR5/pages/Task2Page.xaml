<Page x:Class="PZ2_VAR5.pages.Task2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Task2Page" Height="450" Width="800">
    <Grid Background="White">
        <StackPanel Margin="40,30" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Задача 2: Длина самого длинного слова" 
                       FontSize="20" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,25"/>

            <TextBlock Text="Введите предложение:" FontSize="15" Margin="0,0,0,8"/>

            <TextBox x:Name="tbInput" Width="550" Height="38" FontSize="16" 
                     Padding="8,5" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>

            <Button Content="Найти" Width="160" Height="38" FontSize="15" FontWeight="SemiBold"
                    HorizontalAlignment="Left" Margin="0,20,0,25" Click="btnCalculate_Click"/>

            <TextBlock x:Name="tbResult" FontSize="17" FontWeight="Medium" Foreground="#1E88E5" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>